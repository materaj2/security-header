<?xml version="1.0" encoding="UTF-8"?>
<!--
===========================================================================
Microsoft IIS - Security Headers & Secure Cookie Configuration

This file contains configurations for:
  1. web.config - System.webServer settings (headers, rewrite, request filtering)
  2. system.web - ASP.NET session/cookie settings
  3. PowerShell snippets for SCHANNEL TLS configuration (registry)
  4. PowerShell/appcmd snippets for hiding the Server header

Apply these settings to your IIS installation:
  - Per-site:   <site-root>\web.config
  - Per-app:    <app-root>\web.config
  - Global:     %windir%\System32\inetsrv\config\applicationHost.config

Required IIS modules / features:
  - URL Rewrite Module (https://www.iis.net/downloads/microsoft/url-rewrite)
  - HTTP Redirection
  - Request Filtering (default-installed)
  - Static Content (default-installed)
===========================================================================
-->

<configuration>

    <!-- =================================================================
         1. system.webServer - HTTP Response Headers, Rewrites, Filtering
         ================================================================= -->
    <system.webServer>

        <!-- =============================================================
             1a. Custom HTTP Response Headers
             ============================================================= -->
        <httpProtocol>
            <customHeaders>

                <!-- Remove pre-existing weak/leaky headers first -->
                <remove name="X-Powered-By" />
                <remove name="X-AspNet-Version" />
                <remove name="X-AspNetMvc-Version" />
                <remove name="Server" />

                <!-- Strict-Transport-Security (HSTS)
                     Forces HTTPS for 1 year, includes subdomains, enables preload.
                     IIS 10 (1709+) also supports the native <hsts> element below. -->
                <add name="Strict-Transport-Security"
                     value="max-age=31536000; includeSubDomains; preload" />

                <!-- Content-Security-Policy (CSP) -->
                <add name="Content-Security-Policy"
                     value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" />

                <!-- X-Content-Type-Options -->
                <add name="X-Content-Type-Options" value="nosniff" />

                <!-- X-Frame-Options -->
                <add name="X-Frame-Options" value="DENY" />

                <!-- Referrer-Policy -->
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

                <!-- Permissions-Policy -->
                <add name="Permissions-Policy"
                     value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />

                <!-- X-XSS-Protection (legacy, for older browsers) -->
                <add name="X-XSS-Protection" value="1; mode=block" />

                <!-- Cross-Origin-Opener-Policy (COOP) -->
                <add name="Cross-Origin-Opener-Policy" value="same-origin" />

                <!-- Cross-Origin-Resource-Policy (CORP) -->
                <add name="Cross-Origin-Resource-Policy" value="same-origin" />

                <!-- Cross-Origin-Embedder-Policy (COEP) -->
                <add name="Cross-Origin-Embedder-Policy" value="require-corp" />

                <!-- Cache-Control for dynamic responses (overridden for static
                     assets via the <staticContent> section below). -->
                <add name="Cache-Control"
                     value="no-store, no-cache, must-revalidate, proxy-revalidate" />
                <add name="Pragma" value="no-cache" />
                <add name="Expires" value="0" />

            </customHeaders>
        </httpProtocol>

        <!-- =============================================================
             1b. Native HSTS (IIS 10 build 1709+)
             Equivalent to the Strict-Transport-Security header above.
             Use one or the other, not both.
             ============================================================= -->
        <!--
        <hsts enabled="true"
              max-age="31536000"
              includeSubDomains="true"
              preload="true"
              redirectHttpToHttps="true" />
        -->

        <!-- =============================================================
             1c. URL Rewrite - Force HTTPS (requires URL Rewrite Module)
             ============================================================= -->
        <rewrite>
            <rules>
                <rule name="Force HTTPS" enabled="true" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="off" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect"
                            url="https://{HTTP_HOST}/{R:1}"
                            redirectType="Permanent" />
                </rule>

                <!-- Block HTTP TRACE / TRACK methods (Cross-Site Tracing) -->
                <rule name="Block TRACE/TRACK" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{REQUEST_METHOD}" pattern="^(TRACE|TRACK)$" />
                    </conditions>
                    <action type="CustomResponse"
                            statusCode="405"
                            statusReason="Method Not Allowed"
                            statusDescription="Method Not Allowed" />
                </rule>
            </rules>

            <!-- Outbound rule: rewrite all Set-Cookie headers to enforce
                 Secure; HttpOnly; SameSite=Strict on cookies emitted by
                 the application or upstream. -->
            <outboundRules>
                <rule name="Secure Set-Cookie" preCondition="IsSetCookie">
                    <match serverVariable="RESPONSE_Set_Cookie"
                           pattern="^(.*)$" />
                    <action type="Rewrite"
                            value="{R:1}; Secure; HttpOnly; SameSite=Strict" />
                </rule>
                <preConditions>
                    <preCondition name="IsSetCookie">
                        <add input="{RESPONSE_Set_Cookie}" pattern=".+" />
                    </preCondition>
                </preConditions>
            </outboundRules>
        </rewrite>

        <!-- =============================================================
             1d. Static Content Caching (override no-cache for assets)
             ============================================================= -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge"
                         cacheControlMaxAge="365.00:00:00"
                         cacheControlCustom="public, immutable" />
        </staticContent>

        <!-- =============================================================
             1e. Request Filtering
             - Limit request body size (10 MB)
             - Block dangerous HTTP verbs
             - Hide sensitive file extensions and segments
             ============================================================= -->
        <security>
            <requestFiltering removeServerHeader="true">

                <!-- Maximum request size: 10 MB (10485760 bytes).
                     Increase only if your app accepts large uploads. -->
                <requestLimits maxAllowedContentLength="10485760"
                               maxQueryString="2048"
                               maxUrl="4096" />

                <!-- Allow only common safe verbs. Adjust if your app
                     legitimately uses PATCH, OPTIONS, etc. -->
                <verbs allowUnlisted="false">
                    <add verb="GET"     allowed="true" />
                    <add verb="HEAD"    allowed="true" />
                    <add verb="POST"    allowed="true" />
                    <add verb="PUT"     allowed="true" />
                    <add verb="DELETE"  allowed="true" />
                    <add verb="OPTIONS" allowed="true" />
                    <add verb="TRACE"   allowed="false" />
                    <add verb="TRACK"   allowed="false" />
                </verbs>

                <!-- Block sensitive file extensions -->
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".config" allowed="false" />
                    <add fileExtension=".cs"     allowed="false" />
                    <add fileExtension=".csproj" allowed="false" />
                    <add fileExtension=".vb"     allowed="false" />
                    <add fileExtension=".vbproj" allowed="false" />
                    <add fileExtension=".sln"    allowed="false" />
                    <add fileExtension=".env"    allowed="false" />
                    <add fileExtension=".ini"    allowed="false" />
                    <add fileExtension=".log"    allowed="false" />
                    <add fileExtension=".sql"    allowed="false" />
                    <add fileExtension=".bak"    allowed="false" />
                    <add fileExtension=".swp"    allowed="false" />
                    <add fileExtension=".old"    allowed="false" />
                    <add fileExtension=".orig"   allowed="false" />
                </fileExtensions>

                <!-- Block hidden directories / files (.git, .env, .svn, etc.) -->
                <hiddenSegments>
                    <add segment="bin" />
                    <add segment="obj" />
                    <add segment="App_Data" />
                    <add segment="App_Code" />
                    <add segment=".git" />
                    <add segment=".svn" />
                    <add segment=".hg" />
                    <add segment=".env" />
                    <add segment=".vs" />
                    <add segment="node_modules" />
                </hiddenSegments>

                <!-- Block double-encoded URLs and high-bit characters -->
                <denyUrlSequences>
                    <add sequence=".." />
                    <add sequence=":" />
                    <add sequence="\" />
                </denyUrlSequences>
            </requestFiltering>
        </security>

        <!-- =============================================================
             1f. Directory Browsing - Disable
             ============================================================= -->
        <directoryBrowse enabled="false" />

        <!-- =============================================================
             1g. Default Documents (control what is served at /)
             ============================================================= -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="default.htm" />
                <add value="default.aspx" />
            </files>
        </defaultDocument>

        <!-- =============================================================
             1h. Custom Error Pages (prevent information leakage)
             ============================================================= -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="400" />
            <remove statusCode="401" />
            <remove statusCode="403" />
            <remove statusCode="404" />
            <remove statusCode="500" />
            <error statusCode="400" path="/error/400.html" responseMode="ExecuteURL" />
            <error statusCode="401" path="/error/401.html" responseMode="ExecuteURL" />
            <error statusCode="403" path="/error/403.html" responseMode="ExecuteURL" />
            <error statusCode="404" path="/error/404.html" responseMode="ExecuteURL" />
            <error statusCode="500" path="/error/500.html" responseMode="ExecuteURL" />
        </httpErrors>

        <!-- =============================================================
             1i. Modules - Remove WebDAV (often unnecessary, attack surface)
             ============================================================= -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <handlers>
            <remove name="WebDAV" />
        </handlers>

    </system.webServer>

    <!-- =================================================================
         2. system.web - ASP.NET Cookie / Session / Error Settings
         ================================================================= -->
    <system.web>

        <!-- Hide ASP.NET version banner -->
        <httpRuntime enableVersionHeader="false"
                     maxRequestLength="10240"
                     executionTimeout="90"
                     requestValidationMode="4.5" />

        <!-- Friendly errors only - never expose stack traces in production -->
        <customErrors mode="On" defaultRedirect="/error/500.html">
            <error statusCode="403" redirect="/error/403.html" />
            <error statusCode="404" redirect="/error/404.html" />
        </customErrors>

        <!-- Compilation: never deploy with debug="true" in production -->
        <compilation debug="false" targetFramework="4.8" />

        <!-- Trace: always disabled in production -->
        <trace enabled="false" localOnly="true" />

        <!-- HTTP cookies: enforce HttpOnly + RequireSSL (Secure flag) globally.
             SameSite is set on each cookie individually below. -->
        <httpCookies httpOnlyCookies="true"
                     requireSSL="true"
                     sameSite="Strict" />

        <!-- Forms authentication cookie -->
        <authentication mode="Forms">
            <forms name=".AUTHCOOKIE"
                   loginUrl="~/Account/Login"
                   protection="All"
                   timeout="30"
                   requireSSL="true"
                   slidingExpiration="true"
                   cookieless="UseCookies" />
        </authentication>

        <!-- Session state cookie -->
        <sessionState mode="InProc"
                      cookieless="UseCookies"
                      cookieName="ASP.NET_SessionId"
                      cookieSameSite="Strict"
                      timeout="30"
                      regenerateExpiredSessionId="true" />

        <!-- Anonymous identification cookie -->
        <anonymousIdentification enabled="false" />

        <!-- Machine key: in production, generate explicit keys per environment.
             Auto-generated keys break out-of-process session/forms auth across
             a web farm. Generate via IIS Manager > Machine Key, or PowerShell. -->
        <!--
        <machineKey validationKey="..."
                    decryptionKey="..."
                    validation="HMACSHA256"
                    decryption="AES" />
        -->

        <pages controlRenderingCompatibilityVersion="4.0"
               enableViewStateMac="true"
               viewStateEncryptionMode="Always" />

    </system.web>

    <!-- =================================================================
         3. location-scoped overrides (example: per-path settings)
         ================================================================= -->
    <!--
    <location path="api">
        <system.webServer>
            <security>
                <requestFiltering>
                    <requestLimits maxAllowedContentLength="52428800" />
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    -->

</configuration>

<!--
===========================================================================
PART 2: PowerShell - Hide Server Header & Remove ASP.NET Banner
Run as Administrator. These are server-wide settings.
===========================================================================

# Remove "Server: Microsoft-IIS/x.x" header server-wide (IIS 10+).
Set-WebConfigurationProperty `
    -PSPath 'MACHINE/WEBROOT/APPHOST' `
    -Filter 'system.webServer/security/requestFiltering' `
    -Name 'removeServerHeader' `
    -Value 'true'

# Disable X-Powered-By globally.
Remove-WebConfigurationProperty `
    -PSPath 'MACHINE/WEBROOT/APPHOST' `
    -Filter 'system.webServer/httpProtocol/customHeaders' `
    -Name '.' `
    -AtElement @{ name = 'X-Powered-By' }

# Disable ETag (avoids inode disclosure across web farms).
# IIS does not emit ETag by default for static files when caching is set
# via clientCache, but explicit removal can be forced via outbound rewrite:
#   Match {RESPONSE_ETag} -> Rewrite to empty string.

===========================================================================
PART 3: PowerShell - SCHANNEL TLS Configuration (Windows Server)
Disables SSL 2.0/3.0/TLS 1.0/1.1, enables TLS 1.2/1.3, and sets a strong
cipher suite order. **Reboot required** after running these changes.
===========================================================================

# --- Helper: write a SCHANNEL protocol entry ---
function Set-SchannelProtocol {
    param(
        [string]$Protocol,
        [bool]$Enabled
    )
    $base = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\$Protocol"
    foreach ($role in 'Server','Client') {
        $path = Join-Path $base $role
        if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }
        $value = if ($Enabled) { 1 } else { 0 }
        New-ItemProperty -Path $path -Name 'Enabled'           -Value $value -PropertyType DWord -Force | Out-Null
        New-ItemProperty -Path $path -Name 'DisabledByDefault' -Value (1 - $value) -PropertyType DWord -Force | Out-Null
    }
}

# Disable insecure protocols
Set-SchannelProtocol -Protocol 'SSL 2.0' -Enabled $false
Set-SchannelProtocol -Protocol 'SSL 3.0' -Enabled $false
Set-SchannelProtocol -Protocol 'TLS 1.0' -Enabled $false
Set-SchannelProtocol -Protocol 'TLS 1.1' -Enabled $false

# Enable modern protocols
Set-SchannelProtocol -Protocol 'TLS 1.2' -Enabled $true
Set-SchannelProtocol -Protocol 'TLS 1.3' -Enabled $true   # Windows Server 2022+

# Disable weak ciphers
$weakCiphers = @('RC4 40/128','RC4 56/128','RC4 64/128','RC4 128/128',
                 'DES 56/56','NULL','Triple DES 168')
foreach ($c in $weakCiphers) {
    $p = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Ciphers\$c"
    if (-not (Test-Path $p)) { New-Item -Path $p -Force | Out-Null }
    New-ItemProperty -Path $p -Name 'Enabled' -Value 0 -PropertyType DWord -Force | Out-Null
}

# Set cipher suite order (strongest first - AEAD with ECDHE)
$cipherSuites = @(
    'TLS_AES_256_GCM_SHA384',
    'TLS_AES_128_GCM_SHA256',
    'TLS_CHACHA20_POLY1305_SHA256',
    'TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384',
    'TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384',
    'TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256',
    'TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256',
    'TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256',
    'TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256'
) -join ','

$policy = 'HKLM:\SOFTWARE\Policies\Microsoft\Cryptography\Configuration\SSL\00010002'
if (-not (Test-Path $policy)) { New-Item -Path $policy -Force | Out-Null }
New-ItemProperty -Path $policy -Name 'Functions' -Value $cipherSuites `
                 -PropertyType String -Force | Out-Null

# Reboot required for SCHANNEL changes to take effect.
# Restart-Computer -Force

===========================================================================
PART 4: appcmd - Quick Command-Line Equivalents
===========================================================================

# Remove X-Powered-By header
appcmd.exe set config -section:system.webServer/httpProtocol /-"customHeaders.[name='X-Powered-By']" /commit:apphost

# Add HSTS header (use site name)
appcmd.exe set config "Default Web Site" -section:system.webServer/httpProtocol ^
    /+"customHeaders.[name='Strict-Transport-Security',value='max-age=31536000; includeSubDomains; preload']" /commit:apphost

# Disable directory browsing
appcmd.exe set config -section:system.webServer/directoryBrowse /enabled:"false" /commit:apphost

# Remove WebDAV module
appcmd.exe uninstall module WebDAVModule

===========================================================================
NOTES
===========================================================================
- The <rewrite> section requires the URL Rewrite Module. If you cannot
  install it, replace "Force HTTPS" with the native <httpRedirect> element
  or rely on <hsts redirectHttpToHttps="true" /> in IIS 10 1709+.
- The "Secure Set-Cookie" outbound rule will modify cookies even if the
  application already sets these flags, producing duplicates such as
  "; Secure; Secure". If your app already sets the flags, remove this
  rule, or refine the match pattern to add flags only when missing.
- requireSSL="true" on <httpCookies> requires the site to be served over
  HTTPS; otherwise cookies will not be sent and authentication will break.
- Setting machineKey explicitly is mandatory for web farms and recommended
  for any site using forms auth or out-of-process session state.
-->
